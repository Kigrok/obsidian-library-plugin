{
	"name": "library",
	"version": "2.3.0",
	"description": "Organize movies, series, anime, comics, books, games, and music as visual cards with automatic metadata.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.19.43",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jsdom": "^30.1.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.62.1",
		"vitest": "^3.2.7"
	}
}
